+describe('isOwnHostAuthority', () => {
+  it('accepts loopback authorities with and without a port', () => {
+    for (const host of ['127.0.0.1', '127.0.0.1:3080', 'localhost:3080', '[::1]:3080']) {
+      expect(isOwnHostAuthority(host, [])).toBe(true)
+    }
+  })
+
+  it('accepts declared authorities and refuses undeclared ones', () => {
+    expect(isOwnHostAuthority('192.168.1.10:3080', ['192.168.1.10'])).toBe(true)
+    expect(isOwnHostAuthority('192.168.1.10:3080', ['192.168.1.10:3080'])).toBe(true)
+    expect(isOwnHostAuthority('192.168.1.10:9999', ['192.168.1.10:3080'])).toBe(false)
+    expect(isOwnHostAuthority('192.168.1.11:3080', ['192.168.1.10'])).toBe(false)
+    expect(isOwnHostAuthority('harness.internal:3080', ['HARNESS.INTERNAL'])).toBe(true)
+    expect(isOwnHostAuthority('harness.internal:3080', [])).toBe(false)
+  })
+
+  it('refuses malformed page authorities and malformed declarations', () => {
+    for (const host of ['', ':3080', 'harness.internal:abc', '[::1']) {
+      expect(isOwnHostAuthority(host, ['harness.internal'])).toBe(false)
+    }
+    for (const declared of ['', ':3080', 'harness.internal:abc']) {
+      expect(isOwnHostAuthority('harness.internal:3080', [declared])).toBe(false)
+    }
+  })
+})
