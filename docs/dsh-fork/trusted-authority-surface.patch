diff --git a/packages/client/connection/src/loopback-hostname.ts b/packages/client/connection/src/loopback-hostname.ts
index fe2fe93..98437a5 100644
--- a/packages/client/connection/src/loopback-hostname.ts
+++ b/packages/client/connection/src/loopback-hostname.ts
@@ -16,3 +16,47 @@ export function isLoopbackHostname(hostname: string): boolean {
     && parts[0] === '127'
     && parts.every(part => /^\d{1,3}$/.test(part) && Number(part) <= 255)
 }
+
+/**
+ * Whether a page authority names this deployment's own Host: loopback, or an
+ * authority the Host declared in `trustedHosts`. The declared set is the one
+ * the `/api` fence admits (see `api-request-trust.ts`, which owns the matching
+ * rule), so a page served under one is the operator's own surface even though
+ * it is not on the loopback interface.
+ * @param pageHost - the page's `location.host` (hostname plus written port).
+ * @param trustedAuthorities - declared authorities: exact `host:port`, or port-less `host` matching any port.
+ * @returns true when the page authority is the operator's own Host.
+ */
+export function isOwnHostAuthority(pageHost: string, trustedAuthorities: readonly string[]): boolean {
+  const page = splitAuthority(pageHost)
+  if (page === undefined) return false
+  if (isLoopbackHostname(page.hostname)) return true
+  return trustedAuthorities.some((entry) => {
+    const declared = splitAuthority(entry)
+    if (declared === undefined) return false
+    return declared.hostname === page.hostname && (declared.port === '' || declared.port === page.port)
+  })
+}
+
+/**
+ * Split one `host[:port]` authority into a lowercased hostname (brackets kept
+ * for IPv6 literals) and its written port, `''` when absent.
+ * @param value - authority text as written, e.g. `192.168.1.10:3080`.
+ * @returns the parsed pair, or undefined when the text is not an authority.
+ */
+function splitAuthority(value: string): { hostname: string; port: string } | undefined {
+  const lower = value.toLowerCase()
+  if (lower.startsWith('[')) {
+    const end = lower.indexOf(']')
+    if (end === -1) return undefined
+    const hostname = lower.slice(0, end + 1)
+    const rest = lower.slice(end + 1)
+    if (rest === '') return { hostname, port: '' }
+    const port = rest.slice(1)
+    return rest.startsWith(':') && /^\d+$/.test(port) ? { hostname, port } : undefined
+  }
+  const colon = lower.indexOf(':')
+  if (colon === -1) return lower === '' ? undefined : { hostname: lower, port: '' }
+  const port = lower.slice(colon + 1)
+  return colon > 0 && /^\d+$/.test(port) ? { hostname: lower.slice(0, colon), port } : undefined
+}
