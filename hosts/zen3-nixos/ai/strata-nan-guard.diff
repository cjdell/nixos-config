+// Local diagnostic (2026-10-05, ported from our 0.1.35 audit build): which stage of the grouped expert
+// pipeline first shows a non-finite value.  Env-gated (STRATA_KERNEL_AUDIT=1); off by default.
+namespace {
+__global__ void audit_flat_kernel(const float* __restrict__ rows, long long total, int stage, int layer,
+                                  int* __restrict__ meta) {
+    const long long stride = (long long) gridDim.x * blockDim.x;
+    for (long long i = (long long) blockIdx.x * blockDim.x + threadIdx.x; i < total; i += stride)
+        if (!isfinite(rows[i])) {
+            if (atomicCAS(meta, 0, 1) == 0) {
+                meta[1] = (int) (i % 1000000000LL);
+                meta[2] = (int) (i / 1000000000LL);
+                float v = rows[i];
+                int b;
+                memcpy(&b, &v, 4);
+                meta[3] = b;
+                meta[4] = stage;
+                meta[5] = layer;
+            }
+            return;
+        }
+}
+int* g_stage_audit = nullptr;
+int g_stage_layer = -1;
+bool stage_audit_on() {
+    static const bool on = [] { const char* e = std::getenv("STRATA_KERNEL_AUDIT"); return e != nullptr && e[0] == '1'; }();
+    return on;
+}
+void stage_audit(const float* rows, long long total, int stage, cudaStream_t s) {
+    if (!stage_audit_on() || total <= 0) return;
+    if (g_stage_audit == nullptr) return;   // native_stage_audit_alloc did not run: never audit unallocated
+    audit_flat_kernel<<<256, 256, 0, s>>>(rows, total, stage, g_stage_layer, g_stage_audit);
+}
+}  // namespace
+
+void native_stage_audit_alloc() {   // must run OUTSIDE stream capture (cudaMalloc is not capturable)
+    if (!stage_audit_on() || g_stage_audit != nullptr) return;
+    if (cudaMalloc((void**) &g_stage_audit, 8 * sizeof(int)) != cudaSuccess) { cudaGetLastError(); g_stage_audit = nullptr; }
+}
+
+void native_stage_audit_reset(void* stream) {
+    if (!stage_audit_on() || g_stage_audit == nullptr) return;
+    cudaMemsetAsync(g_stage_audit, 0, 8 * sizeof(int), (cudaStream_t) stream);
+}
+
+void native_stage_audit_layer(int layer) { g_stage_layer = layer; }
+
+bool native_stage_audit_get(int out[8]) {
+    if (!stage_audit_on() || g_stage_audit == nullptr) return false;
+    if (cudaMemcpy(out, g_stage_audit, 8 * sizeof(int), cudaMemcpyDeviceToHost) != cudaSuccess) return false;
+    out[6] = g_stage_layer;
+    return out[0] != 0;
+}
