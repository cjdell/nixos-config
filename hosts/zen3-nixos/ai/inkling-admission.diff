     CONTINUATION_WAIT_S = 600.0
 
+    # Inkling, 2026-11-24 (zen3): the card holds ~178K tokens of K/V at fp16 with the 17.63 GB UD-Q4_K_XL pack, while
+    # one slot may read up to --max-context.  Two big prompts admitted together therefore cannot both be resident: each
+    # read evicts the other's pages and BOTH stall after their first chunk - measured here with two cold 115K reads
+    # (one conversation, one turn apart, 506 tokens of difference): slot 0 sat at "2,048 of 115,216 tokens" for 154 s,
+    # GPU 100 % at 2.28 GHz / 141-166 W, and only a unit restart cleared it.  A request that does not fit beside what
+    # the busy slots already read waits for room instead, bounded like the continuation wait above.
+    FIT_MARGIN = 0.9                 # of max_context: the pool is sized ~1.05-1.1x it, and graphs/SWA share the card
+    FIT_WAIT_S = 600.0
+
+    def _resident_tokens(self) -> int:
+        """K/V the BUSY slots have spoken for: the running prompt, or (after a turn) what the slot holds."""
+        n = 0
+        for b in range(self.batch):
+            if self.slot_busy[b]:
+                n += max(len(self.slot_prompt[b]), len(self.slot_held[b]))
+        return n
+
+    def does_not_fit(self, prompt: list[int]) -> bool:
+        """True when `prompt` cannot be resident beside what the busy slots already read (see FIT_MARGIN): admitting it
+        anyway makes both reads stall.  False when nothing is resident - a lone prompt is the engine's own business."""
+        ctx = int(getattr(self, "max_context", 0) or 0)
+        resident = self._resident_tokens()
+        return bool(ctx and resident and len(prompt) + resident > int(ctx * self.FIT_MARGIN))
+
