+    if (logits == nullptr || n <= 0 || flag == nullptr) return;
+    const int threads = 256;
+    const long long want = (n + threads - 1) / threads;
+    const int blocks = (int) (want < 512 ? (want > 0 ? want : 1) : 512);
+    logits_nonfinite_kernel<<<blocks, threads, 0, (cudaStream_t) stream>>>(logits, n, flag);
+}
+
+// Local fix, not upstream (2026-10-05, ported from our 0.1.35 audit build): records the FIRST non-finite value
+// of a row block - (row, col, raw bits) - so a failure dump can tell a computed canonical NaN from garbage read
+// through a stale path.
+__global__ void record_first_nonfinite_kernel(const float* __restrict__ rows, int k, int n,
+                                              int* __restrict__ meta) {
+    const long long total = (long long) k * (long long) n;
+    const long long stride = (long long) gridDim.x * blockDim.x;
+    for (long long i = (long long) blockIdx.x * blockDim.x + threadIdx.x; i < total; i += stride)
+        if (!isfinite(rows[i])) {
+            if (atomicCAS(meta, 0, 1) == 0) {
+                meta[1] = (int) (i / n);
+                meta[2] = (int) (i % n);
+                float v = rows[i];
+                int b;
+                memcpy(&b, &v, 4);
+                meta[3] = b;
+            }
+            return;
+        }
+}
+
+void record_first_nonfinite(const float* rows, int k, int n, int* meta, void* stream) {
+    if (rows == nullptr || k <= 0 || n <= 0 || meta == nullptr) return;
+    const int threads = 256;
+    const long long want = ((long long) k * n + threads - 1) / threads;
+    const int blocks = (int) (want < 512 ? (want > 0 ? want : 1) : 512);
+    record_first_nonfinite_kernel<<<blocks, threads, 0, (cudaStream_t) stream>>>(rows, k, n, meta);
+}
+
+// Local fix, not upstream (2026-10-05, ported from our 0.1.35 audit build): audits ONLY the rows the GPU plan
+// computed this layer (the plan's dst entries), so a stale row the engine never reads cannot be mistaken for
+// a poisoned one.
+__global__ void audit_hit_rows_kernel(const float* __restrict__ hit_out, const int32_t* __restrict__ dst,
+                                      const int32_t* __restrict__ count, const int32_t* __restrict__ ids,
+                                      int n_embd, int layer, int* __restrict__ meta) {
+    const int j = blockIdx.y;
+    if (j >= *count) return;
+    const int row = dst[j];
+    const float* r = hit_out + (size_t) row * (size_t) n_embd;
+    for (int c = blockIdx.x * blockDim.x + threadIdx.x; c < n_embd; c += gridDim.x * blockDim.x)
+        if (!isfinite(r[c])) {
+            if (atomicCAS(meta, 0, 1) == 0) {
+                meta[1] = row;
+                meta[2] = c;
+                float v = r[c];
+                int b;
+                memcpy(&b, &v, 4);
+                meta[3] = b;
+                meta[4] = ids != nullptr ? ids[row] : -1;
+                meta[5] = layer;
+            }
+            return;
+        }
+}
+
+void audit_hit_rows(const float* hit_out, const int32_t* dst, const int32_t* count, const int32_t* ids,
+                    int64_t entries, int n_embd, int layer, int* meta, void* stream) {
+    if (hit_out == nullptr || meta == nullptr || entries <= 0 || n_embd <= 0) return;
+    const dim3 grid((unsigned) ((n_embd + 255) / 256), (unsigned) (entries < 4096 ? entries : 4096));
+    audit_hit_rows_kernel<<<grid, 256, 0, (cudaStream_t) stream>>>(hit_out, dst, count, ids, n_embd, layer, meta);
+}
+
 }  // namespace strata::kernels
